amends "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.0/hk@2.0.0#/Builtins.pkl"

steps {
  ["actionlint"] = Builtins.actionlint
  ["bom"] = Builtins.byte_order_marker
  ["check_add_large_files"] = Builtins.check_added_large_files
  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_executables_have_shebangs"] = Builtins.check_executables_have_shebangs
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_shebang_scripts_are_executable"] = Builtins.check_shebang_scripts_are_executable
  ["check_symlinks"] = Builtins.check_symlinks
  ["destroyed_symlinks"] = Builtins.destroyed_symlinks
  ["detect_private_key"] = Builtins.detect_private_key
  ["editorconfig_checker"] = Builtins.editorconfig_checker
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["kingfisher"] = Builtins.kingfisher
  ["lychee"] = (Builtins.lychee) { exclude = List("**/git/config", "**/opencode.json*") }
  ["mise"] = Builtins.mise
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["oxfmt"] = Builtins.oxfmt
  ["oxlint"] = Builtins.ox_lint
  ["ruff"] = Builtins.ruff
  ["ruff_format"] = Builtins.ruff_format
  ["rumdl"] = Builtins.rumdl
  ["ryl"] = (Builtins.ryl) { check = "ryl check -d 'extends: default' {{ files }}" }
  ["shellcheck"] = Builtins.shellcheck
  ["shellharden"] = Builtins.shellharden
  ["shfmt"] = (Builtins.shfmt) { check = "shfmt -bn -ci --simplify {{ files }}" }
  ["sql_fluff"] = Builtins.sql_fluff
  ["stylua"] = Builtins.stylua
  ["tombi"] = Builtins.tombi
  ["tombi_format"] = Builtins.tombi_format
  ["trailing_whitespace"] = Builtins.trailing_whitespace
  ["ty"] = Builtins.ty
  ["zizmor"] = Builtins.zizmor

  ["harper"] = (Builtins.harper) {
    check = "harper-cli lint --dialect us {{ files }}"
    exclude =
      List(
        "**/.bash*",
        "**/.profile",
        "**/dictionary.txt",
        "*.conf",
        "*.cshtml",
        "*.css",
        "*.json*",
        "*.pkl",
        "*.prettierrc*",
        "*.ps1",
        "*.sh",
        "*.sql",
        "*.yaml",
        "*config",
        "*git*",
        "*npmrc",
      )
  }
}

exclude = List("node_modules", "dist", "build")
hooks {
  ["fix-minimal"] {
    fix = true
    stash = "git"
    steps = new Mapping<String, Step> {
      ["mixed-line-ending"] = Builtins.mixed_line_ending
      ["newlines"] = Builtins.newlines
      ["trailing-whitespace"] = Builtins.trailing_whitespace
    }
  }
  ["commit-msg"] {
    steps = new Mapping<String, Step> {
      ["check-conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  ["pre-commit"] {
    fix = false
    stash = false
  }
}
